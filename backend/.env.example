# ========================================================
# FinPilot Backend Configuration (.env.example)
# ========================================================

PORT=4000
HOST=0.0.0.0
NODE_ENV=development
# Local development SQLite database path (example for local dev; set persistent path in production)
DATABASE_URL="file:./dev.db"
FRONTEND_URL="http://localhost:3000"

# Authentication & Session Security
# (Must be at least 32 characters in production)
SESSION_SECRET="replace-with-a-secure-random-secret-at-least-32-chars-long"

# Demo & Simulation Flags
SHOW_DEMO_LOGIN=true
# The /simulate route is registered ONLY when true. Public deployments MUST run with simulation off.
ENABLE_PAYMENT_SIMULATION=false
DEMO_USER_EMAIL="demo@finpilot.dev"
DEMO_USER_PASSWORD="replace-with-a-secure-demo-password"

# AI Microservice URL (Python FastAPI on port 5002)
AI_SERVICE_URL="http://localhost:5002"
AI_MOCK_SERVICE_URL="http://localhost:5001"
AI_SERVICE_TOKEN="replace-with-a-secure-random-token"

# PayPal Sandbox Credentials
PAYPAL_ENV=sandbox
PAYPAL_BASE_URL="https://api-m.sandbox.paypal.com"
PAYPAL_CLIENT_ID="your_paypal_sandbox_client_id_here"
PAYPAL_CLIENT_SECRET="your_paypal_sandbox_secret_here"
PAYPAL_WEBHOOK_ID="your_paypal_webhook_id_here"
PAYPAL_INVOICER_NAME="FinPilot Freelance Studio"
PAYPAL_INVOICER_EMAIL="freelancer@example.com"
SIMULATE_PAYPAL_API=false

# Policy Engine Safeguards
MAX_INVOICE_AMOUNT=10000
DUPLICATE_WINDOW_HOURS=24
MAX_REMINDERS_PER_INVOICE=3
MIN_DAYS_BETWEEN_REMINDERS=3

# Prisma Engine Configuration (Recommended for cross-platform binary compatibility)
# --- Prisma Engine Configuration ---
# On Linux, macOS, and Docker: leave unset/commented out (defaults to official Node-API "library").
# On Windows: uncomment or set to "binary" if you encounter "query_engine-windows.dll.node is not a valid Win32 application".
# PRISMA_CLIENT_ENGINE_TYPE="binary"
