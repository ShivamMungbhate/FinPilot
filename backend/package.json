{
  "name": "finpilot-backend",
  "version": "1.0.0",
  "description": "Fastify backend for FinPilot with Prisma, SQLite, and PayPal Invoicing Sandbox integration",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "npx prisma db push --skip-generate && npx tsx prisma/seed.ts && node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:seed": "tsx prisma/seed.ts",
    "seed": "tsx prisma/seed.ts",
    "db:reset": "prisma generate && prisma db push --force-reset && tsx prisma/seed.ts",
    "reset": "npm run db:reset",
    "test:failure": "tsx test-failure-paths.ts",
    "test:immutability": "tsx test-audit-immutability.ts",
    "test:session": "tsx test-session-secret.ts",
    "test:e2e": "tsx test-e2e.ts",
    "test": "tsx test-failure-paths.ts && tsx test-audit-immutability.ts && tsx test-session-secret.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^9.4.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/sensible": "^5.5.0",
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "fastify-raw-body": "^4.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.5.5",
    "prisma": "^5.20.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
